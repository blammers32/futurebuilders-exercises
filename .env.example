# Server only. Never prefix this with VITE_. The browser must not see it.
OPENROUTER_API_KEY=

# Optional. Leave blank to run a demo room on this computer.
# When these are set, instructor login is Firebase email/password
# and student laptops sync through Realtime Database.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
